# MANSA Server — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file (it's in .gitignore).

# ── Runtime mode ──
# 'development' relaxes some checks (auto-generates dev secrets).
# Anything else (or unset) = production.
FLASK_ENV=development

# ── Database ──
MANSA_DB=../mansa.db

# ── P0-6: Security secrets (REQUIRED in production, ≥ 32 chars each) ──
# Generate strong values with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# MANSA_SECRET   → signs Flask sessions / cookies.
# MANSA_ADMIN_TOKEN → independent credential for /api/admin/* endpoints.
#                     Send as HTTP header: X-Admin-Token: <token>
MANSA_SECRET=
MANSA_ADMIN_TOKEN=

# ── P0-5: CORS allowed origins ──
# Comma-separated list. REQUIRED in production.
# Dev default: http://localhost:8080,http://127.0.0.1:8080
MANSA_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ── Email Alerts (Pipeline monitoring) ──
# Stub: leave empty to log alerts to stdout instead of sending.
MANSA_ALERT_EMAIL=
MANSA_SMTP_HOST=smtp.gmail.com
MANSA_SMTP_PORT=587
MANSA_SMTP_FROM=pipeline@mansa.finance
MANSA_SMTP_USER=
MANSA_SMTP_PASS=

# ── P2: Observability (optional) ──
# Sentry: error + performance monitoring. Empty = disabled.
MANSA_SENTRY_DSN=
MANSA_SENTRY_TRACES_RATE=0.05

# Plausible: privacy-first analytics. Empty = disabled.
# Get a domain at https://plausible.io/sites
MANSA_PLAUSIBLE_DOMAIN=

# ── P1-10: Cloudflare Turnstile (anti-bot for register/forgot/community) ──
# Sign up at https://www.cloudflare.com/products/turnstile/
# Leave both empty in dev to skip verification entirely.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set MANSA_CAPTCHA_BYPASS=1 in CI / tests to skip without setting a real secret.
MANSA_CAPTCHA_BYPASS=

# ── Payment providers (P0-3 — currently DISABLED, Option A) ──
# These are kept for future activation. In v2.2-phase0 the premium tier is off.
# When you enable Wave (recommended first), set WAVE_WEBHOOK_SECRET to validate
# the Wave-Signature HMAC header on /api/payment/webhook.
ORANGE_MERCHANT_ID=
ORANGE_API_KEY=
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
